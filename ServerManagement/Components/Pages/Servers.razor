@page "/servers"
@inject NavigationManager NavigationManager

<h3>Servers</h3>
<br/>
<br/>

<CityListComponent SelectedCityCallBack="HandleCitySelection"></CityListComponent>

<br/>

<div class="input-group mb-3">
    <input type="text" class="form-control" placeholder="Search Servers" @bind-value="serverFilter" />
    <button class="btn btn-outline-primary" type="button" id="button-search" @onclick="HandleSearch">Search</button>
</div>

<br/>

<a class="btn btn-primary m-1" href="/servers/add">Add Server</a>

<ServerListComponent @rendermode="InteractiveServer" CityName="@this.selectedCity"></ServerListComponent>


@code {

    private string selectedCity { get; set; } = "Toronto";
    private string serverFilter = "";

    private void HandleSearch()
    {
        // this.servers = ServersRepository.SearchServers(serverFilter);
        // this.selectedCity = string.Empty;
    }

    private void HandleCitySelection(string cityName)
    {
        this.selectedCity = cityName;
    }
}

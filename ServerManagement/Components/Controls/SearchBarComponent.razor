<div class="input-group mb-3">
    <input type="text" class="form-control" placeholder="Search Servers" @bind-value="serverFilter" />
    <button class="btn btn-outline-primary" type="button" id="button-search" @onclick="HandleSearch">Search</button>
</div>

@code {

    [Parameter]
    public EventCallback<string> SearchServerCallback { get; set; }

    private string serverFilter = "";

    private void HandleSearch()
    {
        SearchServerCallback.InvokeAsync(serverFilter);
    }
}


@if(cities != null && cities.Count > 0)
{
    <div class="container-fluid text-center">
        <div class="row w-50">
            @foreach (var city in cities)
            {
                <CityComponent City="@city" SelectedCity="@selectedCity" SelectedCityCallBack="HandleCitySelection"></CityComponent>
            }
        </div>
    </div>
}


@code {

    [Parameter]
    public EventCallback<string> SelectedCityCallBack { get; set; }

    private List<String> cities = CitiesRepository.GetCities();

    private string selectedCity = "Toronto";

    private void HandleCitySelection(string cityName)
    {
        selectedCity = cityName;
        SelectedCityCallBack.InvokeAsync(cityName);
    }
}
